<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/rata_background">

    <TextView
        android:id="@+id/tvPinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pin_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/rata_text_dark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:text="@string/pin_subtitle"
        android:textSize="14sp"
        android:textColor="@color/rata_text_dark" />

    <EditText
        android:id="@+id/etPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pin_hint"
        android:inputType="numberPassword"
        android:maxLength="8"
        android:gravity="center"
        android:textSize="22sp"
        android:letterSpacing="0.3"
        android:padding="12dp"
        android:background="@android:drawable/edit_text" />

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/rata_error"
        android:visibility="invisible"
        android:text="@string/pin_salah" />

    <Button
        android:id="@+id/btnMasuk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/pin_masuk"
        android:backgroundTint="@color/rata_primary"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/tvHubungiAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/pin_hubungi_admin"
        android:textColor="@color/rata_primary"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
